{
  "name": "tubenote",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "description": "TubeNote is a web application that enhances the video-watching experience by enabling users to take intuitive and efficient notes while watching videos.",
  "author": "Lahbiyeb Ismail <ismaillhbibe@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/Lahbiyeb-Ismail/tubenote_v2.git",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter='!@tubenote/server'",
    "dev:server": "turbo dev --filter='!@tubenote/client'",
    "build": "turbo build",
    "build:client": "turbo build --filter='!@tubenote/server'",
    "start:client": "turbo start --filter client",
    "build:server": "turbo build --filter='!@tubenote/client'",
    "start:server": "turbo start --filter server",
    "build:packages": "turbo build --filter='./packages/*'",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "clean": "rm -rf node_modules **/node_modules **/dist **/.next **/.turbo",
    "prepare": "is-ci || husky install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint **/src/**",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "is-ci": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-react/eslint-plugin": "^1.49.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "ts-jest": "^29.2.5",
    "turbo": "^2.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json}": "pnpm lint:fix"
  }
}
